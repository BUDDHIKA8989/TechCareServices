<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2196F3"
        android:padding="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="#2196F3"
            android:backgroundTint="#FFFFFF"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Bookings"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="16dp"
            android:layout_centerVertical="true"/>

    </RelativeLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#FFFFFF"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="All"
                android:textSize="12sp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterReceived"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Received"
                android:textSize="12sp"
                android:backgroundTint="#E3F2FD"
                android:textColor="#2196F3"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterOngoing"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Under Repair"
                android:textSize="12sp"
                android:backgroundTint="#E3F2FD"
                android:textColor="#2196F3"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterReady"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Ready"
                android:textSize="12sp"
                android:backgroundTint="#E3F2FD"
                android:textColor="#2196F3"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterCompleted"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Completed"
                android:textSize="12sp"
                android:backgroundTint="#E3F2FD"
                android:textColor="#2196F3"/>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="64sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No bookings yet"
            android:textSize="18sp"
            android:textColor="#999999"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

    <!-- Bookings RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"/>

</LinearLayout>
