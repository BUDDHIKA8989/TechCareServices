<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2196F3"
            android:padding="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textSize="20sp"
                android:textColor="#2196F3"
                android:backgroundTint="#FFFFFF"
                android:layout_centerVertical="true"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/tvBookingId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking #123"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Received"
                    android:textSize="14sp"
                    android:textColor="#E3F2FD"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Service Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Information"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvServiceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Screen Replacement"
                        android:textSize="18sp"
                        android:textColor="#2196F3"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvDeviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device: Smartphone"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvServicePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cost: Rs2500"
                        android:textSize="16sp"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Issue Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Issue Description"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvIssueDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Screen is cracked and not responding to touch"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- Uploaded Image Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uploaded Image"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <ImageView
                        android:id="@+id/ivBookingImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:background="#F5F5F5"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- Booking Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Booking Details"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvServiceMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Method: Home Pickup"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvBookingDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date: 10/01/2026"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvBookingTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time: 10:00 AM"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address: 123 Main Street"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Technician Info Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTechnician"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Assigned Technician"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTechnicianName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍🔧 Rajesh Kumar"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvTechnicianPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 9876543210"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvEstimatedCompletion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimated Completion: 2-3 hours"
                        android:textSize="14sp"
                        android:textColor="#FF9800"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Status Progress -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repair Status"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvStatusReceived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Request Received"
                        android:textSize="14sp"
                        android:textColor="#4CAF50"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvStatusUnderRepair"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○ Under Repair"
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvStatusReady"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○ Ready for Pickup"
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvStatusCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○ Completed"
                        android:textSize="14sp"
                        android:textColor="#999999"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
