<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2196F3"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, User"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvWelcome"
            android:text="Select a device to repair"
            android:textSize="14sp"
            android:textColor="#E3F2FD"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Logout"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:backgroundTint="#FFFFFF"/>

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_toStartOf="@id/btnLogout"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:text="🔔"
            android:textSize="24sp"
            android:backgroundTint="#FFFFFF"/>

        <TextView
            android:id="@+id/tvNotificationBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_toStartOf="@id/btnLogout"
            android:layout_centerVertical="true"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="20dp"
            android:text="3"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@android:drawable/presence_busy"
            android:gravity="center"
            android:visibility="gone"/>

    </RelativeLayout>


    <!-- Bottom Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home"
            android:textSize="14sp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnBookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="My Bookings"
            android:textSize="14sp"
            android:backgroundTint="#E3F2FD"
            android:textColor="#2196F3"/>

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profile"
            android:textSize="14sp"
            android:backgroundTint="#E3F2FD"
            android:textColor="#2196F3"/>

    </LinearLayout>

    <!-- Devices RecyclerView -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Device Category"
        android:textSize="18sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:padding="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDevices"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"/>

</LinearLayout>
